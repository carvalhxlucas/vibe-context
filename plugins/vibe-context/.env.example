# Copy to ~/.vibecontext/.env. bin/vibecontext creates it on first start.

# Backend
VIBECONTEXT_PORT=8765

# Qdrant: local Docker by default. For Qdrant Cloud, set QDRANT_URL to the cluster URL.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# Dense embeddings: "openai" or "local" (sentence-transformers).
# Changing the provider or model reindexes every document on the next start.
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_BATCH_SIZE=64

# Sparse vectors (BM25 through fastembed). Language drives stemming and stop words.
BM25_LANGUAGE=portuguese

# Reranking: "local" (cross-encoder, about 2 GB downloaded on first start), "cohere" or "none"
RERANK_PROVIDER=local
LOCAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5
SEARCH_CANDIDATES=20

# Automatic injection: on every prompt, add the best reranked excerpts to Claude's
# context. Off by default; Claude calls the search_context tool when it needs it.
VIBECONTEXT_AUTO_INJECT=false
AUTO_INJECT_TOP_K=3
AUTO_INJECT_MIN_SCORE=0.05

# Chunking, in tokens. Defaults fit 512-token local embedding models;
# with OpenAI embeddings you can raise them (for example 800 / 100 / 1000).
TEXT_CHUNK_TOKENS=400
TEXT_CHUNK_OVERLAP=60
CODE_CHUNK_MAX_TOKENS=480

# Uploads
MAX_UPLOAD_MB=50
